{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Rgain",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build:native && npm run build:sidecar && npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:20015",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecars/rgain_parser.exe": "sidecars/rgain_parser.exe",
      "native/libcrypto-3-x64.dll": "libcrypto-3-x64.dll"
    },
    "targets": ["nsis", "msi"]
  },
  "identifier": "com.ViTuler.Rgain",
  "productName": "Rgain",
  "version": "0.1.0"
}
